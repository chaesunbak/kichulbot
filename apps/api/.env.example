DATABASE_URL="postgresql://kichulbot:kichulbot@localhost:5432/kichulbot?schema=public"
PORT="4000"
WEB_ORIGINS="http://localhost:3000,http://localhost:3001"
JWT_SECRET="replace-me-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# 카카오 OAuth는 API 서버에서 처리한다.
KAKAO_CLIENT_ID="replace-me"
KAKAO_CLIENT_SECRET="replace-me"
KAKAO_CALLBACK_URL="http://localhost:4000/api/auth/kakao/callback"

# 인증 관련 웹 리다이렉트 URL
AUTH_WEB_REDIRECT_URL="http://localhost:3000/oauth/callback"
AUTH_PASSWORD_RESET_URL="http://localhost:3000/password-reset"

# 이메일 발송
RESEND_API_KEY="replace-me"
RESEND_FROM_EMAIL="Kichulbot <noreply@example.com>"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
ADMIN_NICKNAME="관리자"

# 파일 스토리지 (MVP 로컬 개발: local / 배포: r2)
STORAGE_DRIVER="local"
STORAGE_PUBLIC_BASE_URL="http://localhost:4000/uploads"
# STORAGE_LOCAL_DIR="<기본값: apps/api/uploads>"

R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<R2 S3 API token access key id>
R2_SECRET_ACCESS_KEY=<R2 S3 API token secret access key>
R2_BUCKET=<bucket name>
R2_PUBLIC_BASE_URL=https://<public-domain-or-r2-dev-url>
