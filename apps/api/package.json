{
  "name": "@kichulbot/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "PORT=4000 WEB_ORIGINS=http://localhost:3000,http://localhost:3001 nest start --watch",
    "build": "prisma generate && nest build",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main",
    "start:dev": "PORT=4000 WEB_ORIGINS=http://localhost:3000,http://localhost:3001 nest start --watch",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"src/infrastructure/generated/**\"",
    "lint:fix": "eslint \"src/**/*.ts\" --ignore-pattern \"src/infrastructure/generated/**\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" --no-error-on-unmatched-pattern",
    "test": "prisma generate && jest",
    "test:watch": "jest --watch",
    "test:cov": "prisma generate && jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --accept-data-loss",
    "prisma:sync": "prisma db push --accept-data-loss && prisma generate",
    "seed": "prisma db seed"
  },
  "dependencies": {
    "@kichulbot/api-contract": "workspace:^",
    "@kichulbot/utils": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "17.4.2",
    "helmet": "^8.2.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-kakao": "^1.0.1",
    "pg": "^8.21.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.4",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@kichulbot/eslint-config": "workspace:*",
    "@kichulbot/typescript-config": "workspace:*",
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-kakao": "^1.0.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.0"
  }
}
