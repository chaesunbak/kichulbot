generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserAuthType {
  ANONYMOUS
  EMAIL
}

enum QuestionType {
  MULTIPLE_CHOICE
  WRITTEN
}

enum AnswerMode {
  ONE_BY_ONE
  EXAM
}

model User {
  id             String          @id @default(cuid())
  email          String?         @unique
  passwordHash   String?
  nickname       String?
  authType       UserAuthType    @default(ANONYMOUS)
  role           UserRole        @default(USER)
  bookshelves    Bookshelf[]
  bookmarkLists  BookmarkList[]
  answerSessions AnswerSession[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Exam {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  papers    Paper[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  papers    Paper[]
  tags      TagSubject[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Paper {
  id             String          @id @default(cuid())
  title          String
  year           Int
  questionCount  Int             @default(20)
  isPublished    Boolean         @default(false)
  examId         String
  subjectId      String
  exam           Exam            @relation(fields: [examId], references: [id])
  subject        Subject         @relation(fields: [subjectId], references: [id])
  questions      Question[]
  users          UserPaper[]
  answerSessions AnswerSession[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([examId])
  @@index([subjectId])
  @@index([isPublished])
}

model Tag {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  isActive  Boolean       @default(true)
  subjects  TagSubject[]
  questions QuestionTag[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([isActive])
}

model TagSubject {
  tagId     String
  subjectId String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([tagId, subjectId])
  @@index([subjectId])
}

model Question {
  id                     String               @id @default(cuid())
  paperId                String
  number                 Int
  type                   QuestionType         @default(MULTIPLE_CHOICE)
  imageUrl               String?
  choiceCount            Int?
  answerChoice           Int?
  answerText             String?
  explanation            String?
  recommendedTimeSeconds Int?
  paper                  Paper                @relation(fields: [paperId], references: [id], onDelete: Cascade)
  tags                   QuestionTag[]
  draftAnswers           DraftAnswer[]
  bookmarks              BookmarkedQuestion[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([paperId, number])
  @@index([paperId])
}

model Bookshelf {
  id        String      @id @default(cuid())
  userId    String
  name      String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  papers    UserPaper[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model UserPaper {
  bookshelfId String
  paperId     String
  bookshelf   Bookshelf @relation(fields: [bookshelfId], references: [id], onDelete: Cascade)
  paper       Paper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([bookshelfId, paperId])
  @@index([paperId])
}

model BookmarkList {
  id        String               @id @default(cuid())
  userId    String
  name      String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions BookmarkedQuestion[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model BookmarkedQuestion {
  bookmarkListId String
  questionId     String
  bookmarkList   BookmarkList @relation(fields: [bookmarkListId], references: [id], onDelete: Cascade)
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([bookmarkListId, questionId])
  @@index([questionId])
}

model AnswerSession {
  id           String        @id @default(cuid())
  userId       String
  paperId      String
  mode         AnswerMode    @default(EXAM)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper        Paper         @relation(fields: [paperId], references: [id], onDelete: Cascade)
  draftAnswers DraftAnswer[]
  submittedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId, paperId, submittedAt])
  @@index([paperId])
}

model DraftAnswer {
  sessionId         String
  questionId        String
  answerChoice      Int?
  answerText        String?
  spentMilliseconds Int           @default(0)
  session           AnswerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question          Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@id([sessionId, questionId])
  @@index([questionId])
}

model QuestionTag {
  questionId String
  tagId      String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([questionId, tagId])
  @@index([tagId])
}
