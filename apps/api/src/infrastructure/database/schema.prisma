generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserAuthType {
  ANONYMOUS
  EMAIL
}

enum QuestionType {
  MULTIPLE_CHOICE
  WRITTEN
}

enum AnswerMode {
  ONE_BY_ONE
  EXAM
}

enum QuestionSetKind {
  OFFICIAL_PAPER
  CUSTOM
  DAILY_WRONG
  DAILY_WEAKNESS
  RECOMMENDED
}

enum AttemptOutcome {
  CORRECT
  INCORRECT
  OMITTED
}

enum QuestionReportCategory {
  QUESTION_ERROR
  IMAGE_ERROR
  CHOICE_ERROR
  ANSWER_ERROR
  EXPLANATION_ERROR
  CATEGORY_ERROR
  OTHER
}

enum QuestionReportStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum TagSelectionMode {
  SINGLE
  MULTIPLE
}

model User {
  id                      String                 @id @default(cuid())
  email                   String?                @unique
  passwordHash            String?
  nickname                String?
  timezone                String                 @default("Asia/Seoul")
  authType                UserAuthType           @default(ANONYMOUS)
  role                    UserRole               @default(USER)
  libraryFolders          LibraryFolder[]
  libraryPapers           UserPaper[]
  solveSessions           SolveSession[]
  questionSets            QuestionSet[]
  generatedQuestionSets   GeneratedQuestionSet[]
  questionAttempts        QuestionAttempt[]
  questionNotes           QuestionNote[]
  questionReports         QuestionReport[]       @relation("QuestionReportReporter")
  reviewedQuestionReports QuestionReport[]       @relation("QuestionReportReviewer")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
}

model Exam {
  id         String         @id @default(cuid())
  name       String
  usesMonth  Boolean        @default(false)
  usesGrade  Boolean        @default(false)
  usesRound  Boolean        @default(false)
  categories ExamCategory[]
  tags       Tag[]
  tagGroups  TagGroup[]
  sessions   ExamSession[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Category {
  id        String         @id @default(cuid())
  name      String
  exams     ExamCategory[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ExamCategory {
  examId     String
  categoryId String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([examId, categoryId])
  @@index([categoryId])
}

model Paper {
  id            String         @id @default(cuid())
  title         String
  questionCount Int            @default(20)
  isPublished   Boolean        @default(false)
  examSessionId String
  questionSetId String         @unique
  examSession   ExamSession    @relation(fields: [examSessionId], references: [id])
  questionSet   QuestionSet    @relation(fields: [questionSetId], references: [id])
  questions     Question[]
  users         UserPaper[]
  solveSessions SolveSession[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([examSessionId])
  @@index([isPublished])
}

model ExamSession {
  id          String   @id @default(cuid())
  key         String   @unique
  examId      String
  displayYear Int
  month       Int?
  grade       Int?
  round       Int?
  exam        Exam     @relation(fields: [examId], references: [id])
  papers      Paper[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([examId, displayYear, month, grade, round])
}

model Tag {
  id         String        @id @default(cuid())
  name       String
  examId     String
  tagGroupId String?
  exam       Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  tagGroup   TagGroup?     @relation(fields: [tagGroupId], references: [id], onDelete: SetNull)
  questions  QuestionTag[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([examId])
  @@index([tagGroupId])
}

model TagGroup {
  id            String           @id @default(cuid())
  examId        String
  name          String
  selectionMode TagSelectionMode @default(MULTIPLE)
  sortOrder     Int              @default(0)
  isActive      Boolean          @default(true)
  exam          Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  tags          Tag[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([examId, isActive, sortOrder])
}

model Question {
  id                     String             @id @default(cuid())
  paperId                String
  number                 Int
  type                   QuestionType       @default(MULTIPLE_CHOICE)
  imageUrl               String
  choiceCount            Int?
  answerChoice           Int?
  answerText             String?
  explanation            String?
  points                 Int                @default(5)
  recommendedTimeSeconds Int?
  paper                  Paper              @relation(fields: [paperId], references: [id], onDelete: Cascade)
  revisions              QuestionRevision[]
  tags                   QuestionTag[]
  notes                  QuestionNote[]
  reports                QuestionReport[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([paperId, number])
  @@index([paperId])
}

model QuestionRevision {
  id                     String             @id @default(cuid())
  questionId             String
  revision               Int
  type                   QuestionType       @default(MULTIPLE_CHOICE)
  imageUrl               String
  choiceCount            Int?
  answerChoice           Int?
  answerText             String?
  explanation            String?
  points                 Int                @default(5)
  recommendedTimeSeconds Int?
  question               Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionSetItems       QuestionSetItem[]
  solveSessionItems      SolveSessionItem[]
  attempts               QuestionAttempt[]
  reports                QuestionReport[]
  createdAt              DateTime           @default(now())

  @@unique([questionId, revision])
  @@index([questionId])
}

model QuestionSet {
  id          String                @id @default(cuid())
  kind        QuestionSetKind
  ownerUserId String?
  title       String
  owner       User?                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  items       QuestionSetItem[]
  generated   GeneratedQuestionSet?
  paper       Paper?
  sessions    SolveSession[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([ownerUserId, kind])
}

model QuestionSetItem {
  questionSetId      String
  questionRevisionId String
  position           Int
  sourceAttemptId    String?
  reason             Json?
  questionSet        QuestionSet      @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  questionRevision   QuestionRevision @relation(fields: [questionRevisionId], references: [id], onDelete: Cascade)
  sourceAttempt      QuestionAttempt? @relation(fields: [sourceAttemptId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())

  @@id([questionSetId, questionRevisionId])
  @@unique([questionSetId, position])
  @@index([questionRevisionId])
  @@index([sourceAttemptId])
}

model GeneratedQuestionSet {
  questionSetId    String          @id
  ownerUserId      String
  kind             QuestionSetKind
  studyDate        DateTime?       @db.Date
  generatorVersion String
  parameters       Json?
  generatedAt      DateTime        @default(now())
  expiresAt        DateTime?
  questionSet      QuestionSet     @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  owner            User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, kind, studyDate])
  @@index([ownerUserId, generatedAt])
}

model LibraryFolder {
  id        String          @id @default(cuid())
  userId    String
  parentId  String?
  name      String
  sortOrder Int             @default(0)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    LibraryFolder?  @relation("LibraryFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  LibraryFolder[] @relation("LibraryFolderTree")
  papers    UserPaper[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, parentId, name])
  @@index([userId])
  @@index([parentId])
}

model UserPaper {
  id        String         @id @default(cuid())
  userId    String
  paperId   String
  folderId  String?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper     Paper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  folder    LibraryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, paperId, folderId])
  @@index([userId])
  @@index([paperId])
  @@index([folderId])
}

model SolveSession {
  id          String             @id @default(cuid())
  userId      String
  paperId     String?
  sourceSetId String?
  mode        AnswerMode         @default(EXAM)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper       Paper?             @relation(fields: [paperId], references: [id], onDelete: Cascade)
  sourceSet   QuestionSet?       @relation(fields: [sourceSetId], references: [id])
  items       SolveSessionItem[]
  submittedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, paperId, submittedAt])
  @@index([paperId])
  @@index([sourceSetId])
}

model SolveSessionItem {
  id                 String            @id @default(cuid())
  sessionId          String
  questionRevisionId String
  position           Int
  session            SolveSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionRevision   QuestionRevision  @relation(fields: [questionRevisionId], references: [id])
  draft              DraftResponse?
  attempts           QuestionAttempt[]
  createdAt          DateTime          @default(now())

  @@unique([sessionId, questionRevisionId])
  @@unique([sessionId, position])
  @@index([questionRevisionId])
}

model DraftResponse {
  sessionItemId     String           @id
  answerChoice      Int?
  answerText        String?
  spentMilliseconds Int              @default(0)
  sessionItem       SolveSessionItem @relation(fields: [sessionItemId], references: [id], onDelete: Cascade)
  updatedAt         DateTime         @updatedAt
}

model QuestionAttempt {
  id                 String            @id @default(cuid())
  userId             String
  sessionItemId      String?
  questionRevisionId String
  answerChoice       Int?
  answerText         String?
  outcome            AttemptOutcome
  spentMilliseconds  Int               @default(0)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionItem        SolveSessionItem? @relation(fields: [sessionItemId], references: [id], onDelete: SetNull)
  questionRevision   QuestionRevision  @relation(fields: [questionRevisionId], references: [id])
  sourceSetItems     QuestionSetItem[]
  gradedAt           DateTime          @default(now())

  @@index([userId, questionRevisionId, gradedAt])
  @@index([userId, gradedAt])
  @@index([sessionItemId])
}

model QuestionTag {
  questionId String
  tagId      String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([questionId, tagId])
  @@index([tagId])
}

model QuestionNote {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  content    String   @db.Text
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([questionId])
}

model QuestionReport {
  id                 String                 @id @default(cuid())
  reporterUserId     String?
  questionId         String
  questionRevisionId String?
  category           QuestionReportCategory
  content            String                 @db.Text
  status             QuestionReportStatus   @default(PENDING)
  adminMemo          String?                @db.Text
  reviewedByUserId   String?
  reviewedAt         DateTime?
  reporter           User?                  @relation("QuestionReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  question           Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionRevision   QuestionRevision?      @relation(fields: [questionRevisionId], references: [id], onDelete: SetNull)
  reviewedBy         User?                  @relation("QuestionReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([category])
  @@index([questionId, status])
  @@index([questionRevisionId])
  @@index([reporterUserId, createdAt])
  @@index([reviewedByUserId])
}
