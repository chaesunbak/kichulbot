# 필수: apps/api/.env의 PAPER_IMPORT_SERVICE_TOKEN과 같은 값을 넣습니다.
PAPER_IMPORT_SERVICE_TOKEN=

# Docker Compose 개발 환경 기준입니다.
REDIS_URL=redis://redis:6379

PAPER_IMPORT_STORAGE_DIR=/app/apps/api/uploads
PAPER_IMPORT_API_BASE_URL=http://host.docker.internal:4000/api

QUESTION_EXTRACTOR_TOOLS_DIR=/app/apps/extractor/question-extractor
PAPER_IMPORT_PYTHON_BIN=/opt/question-extractor-venv/bin/python
