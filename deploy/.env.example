GHCR_OWNER=your-github-owner
IMAGE_TAG=latest

WEB_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
GRAFANA_DOMAIN=grafana.example.com

API_INTERNAL_BASE_URL=http://api:4000/api
PAPER_IMPORT_SERVICE_TOKEN=change-me-to-a-long-random-service-token
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

POSTGRES_USER=kichulbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kichulbot

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-long-random-grafana-password
PROMETHEUS_RETENTION_TIME=90d
PROMETHEUS_RETENTION_SIZE=5GB

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-admin-password
ADMIN_NICKNAME=관리자

# API와 Web 서버가 공유하는 JWT 서명 키입니다. NEXT_PUBLIC_*로 노출하지 마세요.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

STORAGE_DRIVER=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
