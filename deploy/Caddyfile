{
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

{$WEB_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

{$ADMIN_DOMAIN} {
	encode zstd gzip

	handle /api/metrics* {
		respond "Not Found" 404
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy admin:80
	}
}

{$API_DOMAIN} {
	encode zstd gzip

	handle /api/metrics* {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy api:4000
	}
}

{$GRAFANA_DOMAIN} {
	encode zstd gzip
	reverse_proxy grafana:3000
}
