{
  "name": "kichulbot",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "db:up": "docker compose up --wait -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up --wait -d postgres",
    "db:migrate": "pnpm --filter @kichulbot/api prisma:migrate",
    "dev": "pnpm db:up && pnpm db:migrate && turbo run dev --filter=@kichulbot/api --filter=@kichulbot/web --filter=@kichulbot/admin",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@kichulbot/prettier-config": "workspace:*",
    "prettier": "^3.8.3",
    "turbo": "^2.9.15"
  }
}
