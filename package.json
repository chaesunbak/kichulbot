{
  "name": "kichulbot",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "db:up": "docker compose up --wait -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up --wait -d postgres",
    "db:sync": "pnpm --filter @kichulbot/api prisma:push",
    "dev": "pnpm db:up && pnpm db:sync && turbo run dev --filter=@kichulbot/api --filter=@kichulbot/web --filter=@kichulbot/admin",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "lint-staged": "lint-staged",
    "test": "turbo run test",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@kichulbot/prettier-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.15"
  }
}
