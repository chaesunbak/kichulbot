{
  "name": "@kichulbot/api-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "auth": [
        "dist/auth/index.d.ts"
      ],
      "answer-sessions": [
        "dist/answer-sessions/index.d.ts"
      ],
      "bookmarks": [
        "dist/bookmarks/index.d.ts"
      ],
      "library": [
        "dist/library/index.d.ts"
      ],
      "papers": [
        "dist/papers/index.d.ts"
      ],
      "questions": [
        "dist/questions/index.d.ts"
      ],
      "taxonomy": [
        "dist/taxonomy/index.d.ts"
      ],
      "tags": [
        "dist/tags/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./answer-sessions": {
      "types": "./dist/answer-sessions/index.d.ts",
      "import": "./dist/answer-sessions/index.js",
      "default": "./dist/answer-sessions/index.js"
    },
    "./bookmarks": {
      "types": "./dist/bookmarks/index.d.ts",
      "import": "./dist/bookmarks/index.js",
      "default": "./dist/bookmarks/index.js"
    },
    "./library": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/index.js",
      "default": "./dist/library/index.js"
    },
    "./papers": {
      "types": "./dist/papers/index.d.ts",
      "import": "./dist/papers/index.js",
      "default": "./dist/papers/index.js"
    },
    "./questions": {
      "types": "./dist/questions/index.d.ts",
      "import": "./dist/questions/index.js",
      "default": "./dist/questions/index.js"
    },
    "./taxonomy": {
      "types": "./dist/taxonomy/index.d.ts",
      "import": "./dist/taxonomy/index.js",
      "default": "./dist/taxonomy/index.js"
    },
    "./tags": {
      "types": "./dist/tags/index.d.ts",
      "import": "./dist/tags/index.js",
      "default": "./dist/tags/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@kichulbot/typescript-config": "workspace:*",
    "typescript": "^5.7.2"
  }
}
